{
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "description": "Logistics Studio — desktop Bill of Lading (BOL) manager for warehouse and delivery operations. Brand is configurable in Settings; no vendor branding is bundled.",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "main": "dist/main/main.js",
  "name": "logistics-studio",
  "private": true,
  "scripts": {
    "build": "npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dev": "vite",
    "dev:electron": "npm run build:main && electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "gen-pdfs": "node scripts/generate-test-pdfs.mjs",
    "postinstall": "electron-builder install-app-deps",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "version": "0.2.0"
}
